# Self-contained training image: environment + packed dataset + code + one
# run script. Build on a machine with good bandwidth and ~50 GB free disk
# (downloads the pinned HF corpus and packs it INTO the image):
#   docker build -f docker/Dockerfile.selfcontained -t winprob .
# Run the full pipeline (writes /app/out/results.txt and /app/out/model.pt):
#   docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#       --ipc=host --shm-size 16G -v "$PWD/out:/app/out" winprob
# Knobs: -e TRUNK=M -e SSL_EPOCHS=60 -e K_MEMBERS=8
ARG BASE_TAG=latest
FROM rocm/pytorch:${BASE_TAG}

WORKDIR /app
ENV PYTORCH_HIP_ALLOC_CONF=expandable_segments:True \
    MIOPEN_FIND_MODE=FAST \
    PYTHONUNBUFFERED=1

COPY requirements-train.txt .
RUN pip install --no-cache-dir -r requirements-train.txt

COPY pipeline/ pipeline/
COPY configs/ configs/

# Bake the dataset: pinned snapshot -> train-split-only stats -> packed
# bundles. The raw snapshot cache is deleted inside the same layer so only
# the training-ready bundles ship in the image.
RUN python -m pipeline.winprob.data.stats --out data/winprob_bundles/norm_v2.json \
 && python -m pipeline.winprob.data.pack  --out data/winprob_bundles \
 && rm -rf /root/.cache/huggingface

COPY docker/run.sh run.sh
CMD ["bash", "run.sh"]
