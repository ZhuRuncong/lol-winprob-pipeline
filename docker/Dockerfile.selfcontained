ARG BASE_TAG=latest
FROM rocm/pytorch:${BASE_TAG}

WORKDIR /app
ENV PYTORCH_HIP_ALLOC_CONF=expandable_segments:True \
    MIOPEN_FIND_MODE=FAST \
    PYTHONUNBUFFERED=1

COPY requirements-train.txt .
RUN pip install --no-cache-dir -r requirements-train.txt

COPY pipeline/__init__.py pipeline/__init__.py
COPY pipeline/winprob/ pipeline/winprob/
COPY configs/winprob/ssl_M.yaml configs/winprob/finetune.yaml configs/winprob/
COPY docker/strip_source.py /tmp/strip_source.py
RUN python /tmp/strip_source.py pipeline configs && rm /tmp/strip_source.py

RUN python -m pipeline.winprob.data.stats --out data/winprob_bundles/norm_v2.json \
 && python -m pipeline.winprob.data.pack  --out data/winprob_bundles \
 && rm -rf /root/.cache/huggingface

COPY docker/run.sh run.sh
CMD ["bash", "run.sh"]
