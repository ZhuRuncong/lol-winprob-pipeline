# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Process environment variables override anything set here.

# --- GRID API (required for: fetch, ingest) ---
# Your GRID API key. Used to list eligible series and download raw event feeds.
GRID_API_KEY=

# --- Hugging Face (required for: upload) ---
# HF write token: https://huggingface.co/settings/tokens  (needs "write" scope)
HF_TOKEN=
# Target dataset repo, "user_or_org/name".
HF_DATASET_REPO=youruser/lol-winprob
# 1 -> create/keep the HF dataset repo private; 0 -> public.
HF_PRIVATE=0

# --- Scope (optional; defaults enforce the permitted publish scope) ---
# GRID title id for League of Legends.
GRID_TITLE_ID=3
# Maximum lookback ceiling in whole years (the publish-permission limit).
YEARS_BACK=5
# Absolute start-date floor, YYYY-MM-DD. Single source of truth for scope: when
# set and more recent than the YEARS_BACK window, it wins, so fetch never lists
# anything older. Blank = use the YEARS_BACK window. Example: 2026-01-01 = this year.
START_AFTER=

# --- Paths (optional) ---
# Where processed/, pack/, and pipeline_state.json live. Defaults to <project>/data.
# WORK_DIR=./data